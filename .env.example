# Snov.io
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
SNOV_SOURCE_LIST_IDS=            # listas de origem, separadas por vírgula
SNOV_OUTREACH_LIST_ID=           # lista ligada à campanha principal (entra aqui = começa a sequência)
SNOV_DRAFT_LIST_ID=              # lista ligada à campanha "esboço pronto" (fallback de envio do link)

# Marca remetente
SENDER_BRAND=Matilab
SENDER_NAME=Moura
SENDER_WHATSAPP_URL=             # link wa.me usado no CTA da página
DRAFT_BASE_URL=https://analise.matilab.com.br

# Anthropic
ANTHROPIC_API_KEY=
MODEL_FAST=claude-sonnet-5-5
MODEL_DESIGN=claude-opus-5-5

# Google
PAGESPEED_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=                 # connection string Postgres, usada só pelo npm run db:migrate

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_BUCKET=

# Notificações
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operação
DRY_RUN=true
BATCH_SIZE=20                    # prospects por ciclo
MAX_NEW_PER_DAY=60               # novos contatos por dia (ajustar ao número de caixas aquecidas x 30)
MIN_SITE_SCORE_TO_SKIP=75        # site com nota >= isso é considerado bom e descartado
JUDGE_MIN_SCORE=80
DRAFT_TTL_DAYS=30
MAX_DAILY_API_COST_USD=10        # trava: pausa tudo se o custo de API do dia passar disso
LOG_LEVEL=info                   # debug | info | warn | error
