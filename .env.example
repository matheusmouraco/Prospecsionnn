# Snov.io
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
SNOV_SOURCE_LIST_IDS=todas      # "todas" lê todas as listas da conta (menos as de saída e as excluídas) ou ids separados por vírgula
SNOV_EXCLUDE_LIST_IDS=           # listas que nunca entram (clientes, testes), separadas por vírgula
IMPORT_MAX_PER_RUN=300           # prospects novos lidos por rodada (~1 s cada); a próxima rodada continua de onde parou
SNOV_OUTREACH_LIST_ID=           # lista ligada à campanha principal (entra aqui = começa a sequência)
SNOV_CAMPAIGN_ID=                # id da campanha principal (está na URL da campanha no Snov), para ler as respostas
SNOV_DRAFT_LIST_ID=              # lista ligada à campanha "esboço pronto" (fallback de envio do link)

# Marca remetente
SENDER_BRAND=Matilab
SENDER_NAME=Matheus Moura
SENDER_RAZAO_SOCIAL=Matilab Tecnologia   # rodapé dos esboços
SENDER_CNPJ=40.283.248/0001-21
SENDER_WHATSAPP_URL=             # link wa.me usado no CTA da página
DRAFT_BASE_URL=https://analise.matilab.com.br

# Anthropic
ANTHROPIC_API_KEY=
MODEL_FAST=claude-sonnet-5-5
MODEL_DESIGN=claude-opus-5-5

# Google
PAGESPEED_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=                 # connection string Postgres, usada só pelo npm run db:migrate

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_BUCKET=

# Vercel (publicação dos esboços em analise.matilab.com.br)
VERCEL_TOKEN=                    # vercel.com/account/tokens, escopo do time "Matheus Moura's projects"
VERCEL_TEAM_ID=team_EZr88WUvWf8Z5tTgpeDfnbBn
VERCEL_PROJECT=matilab-analise
VERCEL_PANEL_PROJECT=matilab-painel  # painel privado (sempre deploy de prévia, só abre logado na Vercel)

# Notificações
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operação
DRY_RUN=true
BATCH_SIZE=20                    # prospects por ciclo
MAX_NEW_PER_DAY=15               # empresas novas por dia: (contas x envios por conta) / 3, porque cada empresa recebe até 3 emails
MIN_SITE_SCORE_TO_SKIP=75        # site com nota >= isso é considerado bom e descartado
JUDGE_MIN_SCORE=80
DRAFT_TTL_DAYS=30
MAX_DAILY_API_COST_USD=50
LOG_LEVEL=info                   # debug | info | warn | error
