# ===== Site (públicas, aparecem no navegador) =====
NEXT_PUBLIC_SITE_URL=https://supporta.com.br
NEXT_PUBLIC_WHATSAPP=[WHATSAPP]            # ex: +55 11 99999-9999 (o link usa só os dígitos)
NEXT_PUBLIC_EMAIL=[EMAIL]
NEXT_PUBLIC_RAZAO_SOCIAL=[RAZAO_SOCIAL]
NEXT_PUBLIC_CNPJ=[CNPJ]
NEXT_PUBLIC_INSTAGRAM=                     # opcional, URL completa (entra no sameAs do JSON-LD)

# ===== Analytics (carregam só depois do aceite de cookies) =====
NEXT_PUBLIC_GA_ID=                         # G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=                 # 1234567890

# ===== Diagnóstico =====
PSI_API_KEY=[PSI_API_KEY]                  # Google Cloud > APIs > PageSpeed Insights API

# ===== Leads e eventos (CRM / WhatsApp) =====
LEAD_WEBHOOK_URL=[WEBHOOK_URL]             # recebe POST JSON: diagnostico, assinatura_*, pagamento_*
LEAD_WEBHOOK_SECRET=                       # opcional, enviado no header x-webhook-secret

# ===== Banco (Supabase) =====
SUPABASE_DB_URL=                           # Connection string do POOLER (porta 6543, modo transaction). Rodar: npm run db:migrate
SUPABASE_URL=                              # https://<ref>.supabase.co (Storage dos arquivos do briefing)
SUPABASE_SERVICE_ROLE_KEY=                 # só no servidor, nunca em NEXT_PUBLIC_

# ===== E-mail (Resend) =====
RESEND_API_KEY=
EMAIL_FROM=Supporta <oi@supporta.com.br>   # domínio verificado no Resend (SPF/DKIM)
EMAIL_REPLY_TO=                            # opcional
TEAM_EMAIL=                                # avisos internos: nova assinatura, briefing, ajuste, falhas

# ===== Área do cliente e painel =====
SESSION_SECRET=                            # 32+ caracteres aleatórios (openssl rand -base64 48)
ADMIN_USER=admin
ADMIN_PASSWORD=                            # 12+ caracteres; sem ela o /admin fica fechado

# ===== Jobs mensais (Vercel Cron) =====
CRON_SECRET=                               # a Vercel envia como Authorization: Bearer
PLAUSIBLE_API_KEY=                         # relatório de visitas (Pro e Premium)
PLAUSIBLE_URL=https://plausible.io
OPENAI_API_KEY=                            # monitoramento de citações (Premium)
OPENAI_MODEL=gpt-4.1-mini                  # modelo com a ferramenta web_search
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash              # modelo com google_search
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# ===== Pagamento =====
PAYMENT_PROVIDER=asaas                     # asaas | stripe. Sem chave = modo teste (fora de produção)

# Asaas
ASAAS_API_KEY=[CHAVE_PAGAMENTO]
ASAAS_API_URL=https://api.asaas.com/v3     # sandbox: https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=                       # o mesmo token cadastrado no webhook do painel Asaas

# Stripe Billing
STRIPE_SECRET_KEY=[CHAVE_PAGAMENTO]
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=                        # price_... recorrente mensal de R$89
STRIPE_PRICE_PRO=                          # price_... recorrente mensal de R$189
STRIPE_PRICE_PREMIUM=                      # price_... recorrente mensal de R$389
