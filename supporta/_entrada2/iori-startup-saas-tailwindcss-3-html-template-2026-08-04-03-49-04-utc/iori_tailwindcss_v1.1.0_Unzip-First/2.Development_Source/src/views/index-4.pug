extends layout/layout

block vars
  - title = 'Homepage 4 - IORI Marketplace Template';
  - bodyClass = 'homepage-4-styles';

block container
  .bg-second-brand.relative.bg-no-repeat.bg-right-top(
    class='bg-[url(\'/assets/images/page/homepage4/finger.png\')] before:bottom-0 before:left-0 before:absolute before:w-[133px] before:h-[150px] before:z-[1] before:bg-[url(\'/assets/images/page/homepage4/finger-2.png\')] before:bg-no-repeat before:bg-contain before:bg-left-bottom'
  )
    +MainContainer
      a.absolute.left-0.right-0.m-auto.bottom-5.h-14.w-14.bg-contain.bg-no-repeat.bg-center.hero-thumb-animation(
        href='#',
        class='bg-[url(\'/assets/images/icons/icon-scroll-bar1.svg\')]'
      )
      .grid.grid-cols-12.items-center.pb-16(class='pt-[72px]')
        .col-span-12.mb-11(class='lg:col-span-7 lg:mb-0')
          +FlexCol
            +ItemsCenter.gap-x-3.mb-2
              span.w-12.bg-first-brand(class='h-[1px]')
              span.font-medium.text-gray-400(class='text-[18px] leading-[18px]') Get Started
            p.text-first-brand.font-extrabold(
              class='text-[34px] leading-[40px] mb-[30px] sm:text-[50px] sm:leading-[60px] lg:text-[64px] lg:leading-[72px]'
            ) Start for free <br> Pay as you Grow
            +TextBase('Collaborate, plan projects and manage resources with powerful features that your whole team can use. The latest news, tips and advice to help you run your business with less fuss.').mb-10(
              class='xl:max-w-[601px]'
            )
            +Heading5('Available on')(class='mb-[22px]')
            .flex.items-start.gap-x-9.flex-col.gap-y-4(class='sm:flex-row sm:items-center')
              +ItemsCenter.gap-x-4
                img(src='assets/images/AppStore.svg', alt='AppStore')
                img(src='assets/images/AppGooglePlay.svg', alt='AppGooglePlay')
              +RightArrowButton('Learn More', '#')
        .col-span-12.relative(class='lg:col-span-5')
          .absolute.hero-thumb-animation.opacity-50(class='top-[40%] left-[-70px] z-[1]')
            img(src='assets/images/homepage-9-arrow-down.svg', alt='Arrow Down')
          .absolute.bottom-0.hero-thumb-sm-animation.opacity-50(class='z-[1] left-[calc(100%-95px)]')
            img(src='assets/images/homepage-9-arrow-right.svg', alt='Arrow Right')
          form.relative(action='#', class='z-[2]')
            +FlexCol.bg-gray-0.border.border-third-brand.rounded-lg.shadow-drop-shadown-2.px-11.ml-auto(
              class='pt-[46px] pb-[49px] lg:max-w-[449px]'
            )
              +Heading4('Sign up for free').mb-9
              p.flex.flex-col.gap-y-3.mb-6
                label(for='email') Your email *
                input#email.bg-gray-0.border.border-gray-80.rounded-lg.pl-6(
                  type='email',
                  name='email',
                  placeholder='stevenjob@gmail.com',
                  class='py-[18px]'
                )
              p.flex.flex-col.gap-y-3.mb-6 
                label(for='password') Your password
                input#password.bg-gray-0.border.border-gray-80.rounded-lg.pl-6(
                  type='password',
                  name='password',
                  placeholder='************',
                  class='py-[18px]'
                )
              p.flex.items-center.mb-6(class='gap-x-[10px]')
                input#rememberMe(type='checkbox', value='lsRememberMe')
                label.font-medium.text-gray-900.text-header-9(for='rememberMe') Remember me
              button.w-full.bg-first-brand.text-gray-0.font-bold.text-header-6.rounded-lg.py-4.mb-4 Sign In
              button.flex.items-center.justify-center.border.border-gray-80.bg-gray-0.rounded-lg(
                class='gap-x-[10px] py-[18px] mb-[22px]'
              )
                +ImageShrink('assets/images/icons/icon-google.svg', 'Google Icon')
                span.text-header-9.font-bold(class='text-[#414357]') Sign in with Google
              p.text-mini-desc.font-medium.text-gray-400.text-center Already have an account?
                a.text-first-brand.ml-1(href='#') Sign in.
