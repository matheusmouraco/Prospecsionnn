extends layout/layout

block vars
  - title = 'Blog - IORI Marketplace Template';
  - bodyClass = 'blog-listing-1-styles';
  - var dotIcon = '/assets/images/page/blog/dot.svg';
  - var bgFree1 = '/assets/images/blog-bg-free1.svg';

block container
  .w-screen.bg-gray-60.relative.h-max(class='mb-[81px]')
    .w-full(class='xl:absolute xl:top-1/2 xl:-translate-y-1/2')
      +MainContainer
        .grid.grid-cols-12.items-center
          .col-span-12.ml-0(class='xl:col-span-7 2xl:col-span-6 m-[30px]')
            h1.text-first-brand.font-extrabold.text-3xl.leading-9.mr(
              class='xl:text-[48px] xl:leading-[56px] mb-[20px]'
            ) All the important insights, guidance and news you need to know.
            .grid.grid-cols-12 
              .col-span-12(class='xl:col-span-9 xl:pr-10')
                +Heading6('Keep up-to-date with all our latest company news and business content. The latest news, tips and advice to help you run your business with less fuss')
    .grid.grid-cols-12.item-center 
      .col-span-6
      .col-span-6(class='pl-[70px]')
        img.w-full.hidden(src='assets/images/page/blog/banner.png', alt='Banner', class='xl:block')
  +MainContainer
    +Heading2('Lastest Articles').text-center(class='mb-[51px]')
    ul.inline-block.w-full.text-center.tabLastestArticles(class='mb-[68px]')
      li.inline-block.mx-1.active.mb-8
        a.border.border-gray-80.rounded-lg.bg-gray-0.py-3.font-medium.text-base.text-gray-500.transition-common(
          href='#allArticles',
          class='px-[22px] hover:bg-first-brand hover:border-first-brand hover:text-second-brand'
        ) All articles
      li.inline-block.mx-1.mb-8
        a.border.border-gray-80.rounded-lg.bg-gray-0.py-3.font-medium.text-base.text-gray-500.transition-common(
          href='#featured',
          class='px-[22px] hover:bg-first-brand hover:border-first-brand hover:text-second-brand'
        ) Featured
      li.inline-block.mx-1.mb-8
        a.border.border-gray-80.rounded-lg.bg-gray-0.py-3.font-medium.text-base.text-gray-500.transition-common(
          href='#company',
          class='px-[22px] hover:bg-first-brand hover:border-first-brand hover:text-second-brand'
        ) Company
