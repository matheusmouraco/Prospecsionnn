  section.team.relative
    +MainContainer.team-have-question
      .grid.grid-cols-12.items-center(class='gap-[30px]')
        .col-span-full(class='min-[1024px]:col-span-5') 
          +FlexCol
            +Heading2('Have a question? Our team is happy to help you').mb-6.title
            +TextBase('Access advanced order types including limit, market, stop limit and dollar cost averaging. Track your total asset holdings, values and equity over time. Monitor markets, manage your portfolio, and trade crypto on the go.').mb-9
            +ItemsCenter.gap-6
              +NormalButton('Contact Us')
              +RightArrowButton('Help Center', '#')
        .col-span-full.col-span-7(class='min-[1024px]:col-span-7')
          .grid.grid-cols-12(class='gap-[17px]')
            .col-span-7.relative
              +ImageCover('assets/images/team/question/img1.png', 'Iori')
            .col-span-5.h-full
              +FlexCol.h-full(class='gap-[17px]')
