extends layout/layout

block vars
  - title = 'Homepage 3 - IORI Marketplace Template';
  - bodyClass = 'homepage-3-styles';

block container
  .block(class='bg-[#EBF5F8]')
    +MainContainer 
      .grid.grid-cols-1.items-end(class='lg:grid-cols-2')
        +FlexCol.pt-20.pb-10
          +ItemsCenter.gap-x-3.mb-2
            span.w-12.bg-first-brand(class='h-[1px]')
            span.font-medium.text-gray-400(class='text-[18px] leading-[18px]') Get Started
          +Heading1('Grow your online business now').mb-7(class='lg:max-w-[546px]')
          a.flex.items-center.hover-up.cursor-pointer.mb-12.play-video(href='#', class='gap-x-[11px]')
            +ImageShrink('assets/images/icons/icon-btn-play.svg', 'Play Icon')
            span.font-bold.text-first-brand(class='text-[14px] leading-[18px]') Play Video
          .flex 
            img.mr-4(src='assets/images/page/homepage3/chart1.png', alt='Chart', class='w-[53%]')
            img(src='assets/images/page/homepage3/chart2.png', alt='Chart', class='w-[47%]')
        .relative.hidden(class='lg:block')
          .relative.w-full.h-full(
            class='before:w-full before:h-full before:top-0 before:left-0 before:absolute before:z-[1] before:bg-contain before:bg-center before:bg-no-repeat before:bg-[url(\'/assets/images/page/homepage3/bg-banner.png\')]'
          )
            +ImageSrcSet('assets/images/homepage-3-banner-human.png 2x', 'Human').relative.block(
              class='z-[2] left-[-70px]'
            )
          .block.absolute.right-0.hero-thumb-animation.bottom-8(class='z-[3]')
            img(src='assets/images/page/homepage3/chart.png', alt='Chart') 
