          +TextBase('Discover powerful features to boost your productivit. You are always welcome to visit our little den. Professional in teir craft! All products were super amazing with strong attension to details, comps and overall vibe.').mb-8
          +RightArrowButton('Learn More', '#')
      .block.px-11.pt-14.bg-gray-0.border.border-gray-100.rounded-2xl.hover-up-all(
        class='pb-[68px] hover:bg-gray-60 hover:border-gray-60'
