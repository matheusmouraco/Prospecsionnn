mixin BlogItem(image, title, desc, tag, date, time, link)
  .px-5.overflow-hidden.bg-gray-0.rounded.border.border-gray-80.pt-5.pb-4.hover-up
    .block 
      img.w-full.h-auto.rounded(src=image, alt=title)
    .mt-3
      a(href='#') 
        p.font-bold.text-first-brand.mb-3.transition-common(
          class='text-[18px] leading-[24px] hover:text-success'
        )= title
      p.font-medium.text-gray-500.border-b.border-gray-50(
        class='text-[12px] leading-[18px] mb-[18px] pb-[27px]'
      )= desc
      +ItemsCenter(class='gap-[22px]')
        a.text-first-brand.font-bold.py-2.border.rounded.border-first-brand.transition-common(
          href=link,
          class='text-[12px] leading-[12px] px-[10px] hover:text-success'
        )= tag
        +ItemsCenter.gap-x-1
          +ImageShrink('assets/images/icons/icon-date.svg', 'Date Icon')
          time.text-gray-300.font-medium(class='text-[10px] leading-[12px]')= date
        +ItemsCenter.gap-x-1
          +ImageShrink('assets/images/icons/icon-time.svg', 'Time Icon')
          span.text-gray-300.font-medium(class='text-[10px] leading-[12px]')= time

mixin Blog02Item(image, title, date, time, desc, avatar, name, position, link)
