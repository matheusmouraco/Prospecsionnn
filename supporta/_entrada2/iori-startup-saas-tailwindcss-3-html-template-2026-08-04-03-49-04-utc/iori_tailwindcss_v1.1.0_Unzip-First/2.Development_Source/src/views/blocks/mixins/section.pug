mixin MarketingItemSection(image, tag, title, desc, link, reverse=false, rounded=true)
  .grid.grid-cols-1.relative.overflow-hidden(class='lg:grid-cols-2', class=rounded ? 'rounded-lg' : null)&attributes(attributes)
    .block 
      +ImageCover(image, title)
    .bg-first-brand.flex.items-center.p-5(class=reverse ? 'col-start-1 row-start-1 lg:pr-16' : 'xl:pl-16')
      +FlexCol(class='lg:max-w-[531px]', class=reverse ? 'ml-auto' : '')
        button.bg-third-brand.rounded.text-first-brand.font-bold.w-fit.pb-2.mb-2(
          class='text-[12px] leading-[12px] pl-[11px] pr-[10px] pt-[5px]'
        )= tag
        p.font-bold.text-second-brand(
          class='text-[22px] leading-[28px] lg:text-[32px] lg:leading-[44px] mb-[11px]'
        )= title
        p.text-base.text-white.font-medium(class='mb-[38px] lg:mb-[76px]')= desc
        a.flex.items-center.hover-up.cursor-pointer.play-video(href=link, class='gap-x-[11px]')
          +ImageShrink('assets/images/icons/icon-btn-play.svg', 'Play Icon')
          span.font-bold.text-second-brand(class='text-[14px] leading-[18px]') Play Video
    .absolute.bottom-0(class=reverse ? 'left-0' : 'right-0')
      +ImageCover('assets/images/icons/icon-finger-2.svg', 'Finger')

mixin ChooseTheBestPlanSection(bgColor='bg-seventh-bg', finger=true)
  .block(class='pt-[65px] lg:pt-[131px] pb-[71px] lg:pb-[143px]', class=bgColor, class=finger ? 'relative' : '')&attributes(attributes)
    if finger
      .absolute.top-0.left-0.opacity-50
        img(src='assets/images/icons/icon-finger-3.svg', alt='Finger')
    else
      .absolute
    +MainContainer.relative
      +Heading2('Choose The Best Plan').mb-5
      .flex.flex-col.justify-between.items-start.gap-y-2(
        class='md:mb-14 md:flex-row md:items-end mb-[45px]'
      )
        p.text-gray-500.font-medium.text-header-7 Pick your plan. Change whenever you want. <br> No switching fees between packages
        +RightArrowButton('Compare plans', '#')
      .grid.grid-cols-1(class='gap-[30px] md:grid-cols-2 xl:grid-cols-4')
        +BestPlanItem('assets/images/icons/icon-trial-plan.svg', 'fourth', 'Trial Plan', 'Protect for testing', 'free', '- 30 days trial', 'No Credit card required', true, true, true, false, false, false, false, false, '#', 'Try for free')
        +BestPlanItem('assets/images/icons/icon-standard.svg', 'first', 'Standard', 'Advanced project', '$29', '- user / month', 'Billed annually', true, true, true, true, true, false, false, false, '#', 'Get Started')
        +BestPlanItem('assets/images/icons/icon-business.svg', 'second', 'Business', 'Protect for testing', '$99', '- user / month', 'Billed annually', true, true, true, true, true, true, false, false, '#', 'Get Started')
        +BestPlanItem('assets/images/icons/icon-enterprise.svg', 'fifth', 'Enterprise', 'Protect for testing', '$299', '- user', 'One-time pay', true, true, true, true, true, true, true, true, '#', 'Get Started')

