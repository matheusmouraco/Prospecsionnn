mixin JustifyCenter
  .flex.items-center.justify-center&attributes(attributes)
    if block
      block

mixin JustifyBetween
  .flex.items-center.justify-between&attributes(attributes)
    if block
      block

mixin ItemsCenter
  .flex.items-center&attributes(attributes)
    if block
      block

mixin FlexCol
  .flex.flex-col&attributes(attributes)
    if block
      block

mixin ItemsStart
  .flex.items-start&attributes(attributes)
    if block
      block

mixin ItemsEnd
