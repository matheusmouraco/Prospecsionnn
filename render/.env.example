# Nome do produto (aparece na interface e nas meta tags)
NEXT_PUBLIC_APP_NAME=ArquiStudio

# Chave da API do Gemini (Google AI Studio). Sem ela o editor roda em modo demonstração.
GEMINI_API_KEY=

# Modelos (troque aqui quando o Google lançar versões novas, sem mexer no código)
GEMINI_MODEL_STANDARD=gemini-3.1-flash-image
GEMINI_MODEL_HD=gemini-3-pro-image
GEMINI_MODEL_TEXT=gemini-2.5-flash

# Formato da chamada: interactions (API atual do Google) ou generateContent (formato antigo).
# Se a escolhida recusar, o código tenta a outra sozinho.
GEMINI_API_STYLE=interactions
GEMINI_API_REVISION=2026-05-20

# Custo estimado por imagem em US$ (só para mostrar custo e margem; confira a tabela do Google,
# o preço do gemini-3.1-flash-image não estava na página quando isto foi escrito)
COST_USD_STANDARD=0.039
COST_USD_HD=0.134

# Senha de acesso ao editor. Enquanto não houver login (etapa 3), protege sua chave da API.
# Deixe vazio só em ambiente local.
ACCESS_PASSWORD=

# Limite simples de renders por IP por hora (proteção básica até a etapa 3)
MAX_RENDERS_PER_HOUR=60
